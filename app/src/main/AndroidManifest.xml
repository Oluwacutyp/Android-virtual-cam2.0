<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Phase 1: camera compositor + recording prep. No internet permission:
         the app is fully offline by design (blueprint §A.8 / privacy-first). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Round-31: legacy (API <29) writes to the PUBLIC Movies/VCamStudio dir
         only. On API 29+ recordings go through MediaStore (no permission). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <!-- Phase 2 (owner mandate): model downloads are user-initiated fetches
         from the configured HuggingFace mirrors. This is the app's first
         network permission — inference itself stays fully on-device. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- r54-B1: :ai foreground service (child-survival remedy). specialUse
         is the only type that fits a non-media, non-location worker. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".StudioApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VCamStudio"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:theme="@style/Theme.VCamStudio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.vcamstudio.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Round 47 (owner mandate): ORT process isolation. OrtEnvironment
             .createSession aborts natively inside libonnxruntime.so (two ORT
             versions, same signature: no Kotlin trace, no crash file). All
             session work happens in the :ai child process so a native crash
             can never take the studio down. -->
        <service
            android:name=".ai.AiInferenceService"
            android:process=":ai"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- r54-B1: the property names the special-use reason (API 34
                 requires a type; missing type throws at startForeground). -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="keeps the out-of-process AI inference child alive for live face detection" />
        </service>
        <!-- r53: hands the transport ring SharedMemory to consumer processes
             (the Xposed hook inside the target app). Deliberately exported:
             consumers run under other uids; it serves exactly one read-only
             frame ring and nothing else. -->
        <provider
            android:name="com.vcamstudio.app.transport.TransportProvider"
            android:authorities="com.vcamstudio.app.transport"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!-- r53: this APK is ALSO an Xposed module (route R, root hook).
             Scope this round: Camera1 apps only. -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="VCamStudio transport v0 (Camera1 preview injection)" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
    </application>
</manifest>
